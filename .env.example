# Optional. Copy to .env to choose an LLM provider. ./demo.sh and ./book.sh both read it.
#   fake       offline stand-in, no model needed (book default when unset)
#   ollama     local Ollama (interview demo default when unset)
#   openai     needs OPENAI_API_KEY
#   deepinfra  needs DEEPINFRA_API_KEY
# LLM_PROVIDER=ollama
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
