# Image for running the book's chapters inside Docker (./book.sh docker-run <NN>).
# The repository is copied in, so no bind mount (or Docker Desktop WSL integration) is needed.
# ./book.sh docker-* passes --build, so code edits are picked up on the next run.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl procps \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
ENV PYTHON=python \
    MLFLOW_DISABLE_AGENT_HINT=1 \
    GIT_PYTHON_REFRESH=quiet
WORKDIR /work
COPY . /work
ENTRYPOINT ["./book.sh"]
CMD ["list"]
